# Local development: email is captured at http://localhost:8025 and is never
# delivered externally. Register an account, then assign admin on the server:
# docker compose exec backend /app/taverna-admin -email your@email.example
# Add -claim-legacy only to assign projects created before accounts existed.
PUBLIC_APP_URL=http://localhost:5173/
POSTGRES_PASSWORD=taverna
# Change NETWORK_PREFIX if this subnet conflicts with another Docker network.
NETWORK_PREFIX=172.30.24
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_COOKIE_SECURE=false
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_ALLOW_INSECURE=true
SMTP_FROM=noreply@taverna.local
SMTP_USERNAME=
SMTP_PASSWORD=

# Production: serve frontend and /api on the same HTTPS origin; configure real
# SMTP with STARTTLS, set SMTP_ALLOW_INSECURE=false and AUTH_COOKIE_SECURE=true.
# Keep SMTP credentials only on the server; never use VITE_* for secrets.
# APP_DOMAIN=taverna.example.com
# Starter models: registered administrator credentials, used only by the seed tool.
# TEST_ADMIN_EMAIL=owner@example.com
# TEST_ADMIN_PASSWORD=
